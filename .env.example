# Run pnpm run local:init to generate independent random secrets in a mode-0600 .env.
DATABASE_URL=postgres://amazon_mcp:local-development-only@127.0.0.1:55432/amazon_mcp
DATA_ENCRYPTION_KEY=
MCP_TOKEN=
OWNER_TOKEN=
OWNER_ID=local-owner
PORT=3433
AMAZON_PROFILE_DIR=.local/amazon-profile
# Enable only after accepting the documented source-access basis and completing dedicated login.
AMAZON_LIVE_ENABLED=false
# Optional minimal history; source retention must permit it.
RETAIN_OBSERVATIONS=false
