# Run pnpm run local:init to generate independent random secrets in a mode-0600 .env.
DATABASE_URL=postgres://amazon_mcp:local-development-only@127.0.0.1:55432/amazon_mcp
DATA_ENCRYPTION_KEY=
MCP_TOKEN=
OWNER_TOKEN=
OWNER_ID=local-owner
PORT=3433
AMAZON_PROFILE_DIR=.local/amazon-profile
# Background worker mode; browser:login always opens a visible window.
AMAZON_HEADLESS=true
# Optional 1Password Login item ID/title and vault; omit for a unique Amazon login.
# AMAZON_1PASSWORD_ITEM=
# AMAZON_1PASSWORD_VAULT=
# Enable only after accepting the documented source-access basis and completing dedicated login.
AMAZON_LIVE_ENABLED=false
# Optional minimal history; source retention must permit it.
RETAIN_OBSERVATIONS=false

# Paid integration is optional and needs an existing key plus explicit enablement.
KEEPA_ENABLED=false
KEEPA_API_KEY=
# Per gateway process; restarting resets these local limits.
KEEPA_MAX_CALLS=100
KEEPA_MAX_TOKENS=100

# macOS optional generic desktop notices; disabled until explicitly configured.
DESKTOP_NOTIFICATIONS=false
