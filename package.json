{
  "name": "amazon-shopping-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx apps/gateway/main.ts",
    "worker": "tsx apps/worker/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "browser:login": "tsx scripts/browser-login.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "graphile-worker": "0.18.0",
    "mcp-handler": "2.2.0",
    "pg": "8.16.3",
    "playwright": "1.63.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.12.0",
    "@types/pg": "8.15.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
