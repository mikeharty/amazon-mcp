{
  "name": "amazon-shopping-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "dev": "node --env-file=.env --import tsx apps/gateway/main.ts",
    "worker": "node --env-file=.env --import tsx apps/worker/main.ts",
    "migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "browser:login": "node --env-file=.env --import tsx scripts/browser-login.ts",
    "local:init": "tsx scripts/setup.ts",
    "mcp:smoke": "node --env-file=.env --import tsx scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "graphile-worker": "0.18.0",
    "mcp-handler": "2.2.0",
    "pg": "8.16.3",
    "playwright": "1.63.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.12.0",
    "@types/pg": "8.15.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
